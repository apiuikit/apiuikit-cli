{
  "name": "@apiuikit/cli",
  "version": "0.2.0",
  "description": "Generate a static API documentation site from a local OpenAPI or AsyncAPI spec, powered by APIUIKit.",
  "keywords": [
    "openapi",
    "asyncapi",
    "swagger",
    "api",
    "documentation",
    "docs",
    "cli",
    "apiuikit",
    "static-site"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "apiuikit": "./bin/apiuikit.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apiuikit/apiuikit-cli"
  },
  "bugs": {
    "url": "https://github.com/apiuikit/apiuikit-cli/issues"
  },
  "homepage": "https://github.com/apiuikit/apiuikit-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "start": "npm run build && node bin/apiuikit.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@apiuikit/web-component": "^1.5.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@asyncapi/parser": "^3.6.0",
    "@scalar/openapi-parser": "^0.28.10"
  },
  "peerDependenciesMeta": {
    "@asyncapi/parser": {
      "optional": true
    },
    "@scalar/openapi-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.3",
    "@changesets/cli": "^3.0.1",
    "@scalar/openapi-parser": "^0.28.10",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
